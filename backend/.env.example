# Local dev settings for running the API outside Docker. Copy to backend/.env.
# Everything has a working default, so this file is optional.
DATABASE_URL=sqlite:///./chindi.db
ALLOW_SIGNUPS=false
# Set true to allow additional people to create their own Chindi accounts.
DEFAULT_CURRENCY=CAD
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional password-reset email; recovery codes work without an email service.
# Set APP_URL to the public HTTPS origin before enabling email links or phone passkeys.
APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
