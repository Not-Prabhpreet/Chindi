# Copy to .env and fill in. Never commit .env.

# Postgres (used by the db service and by DATABASE_URL below)
POSTGRES_USER=chindi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chindi

# API
DATABASE_URL=postgresql+psycopg://chindi:change-me@db:5432/chindi
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Sign-ups stay off; the first user can always register.
ALLOW_SIGNUPS=false
DEFAULT_CURRENCY=CAD

# Web push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Public URL of the app. APP_DOMAIN is the host Caddy gets an HTTPS certificate for.
# Use APP_DOMAIN=localhost for local runs.
APP_URL=https://chindi.example.com
APP_DOMAIN=chindi.example.com
